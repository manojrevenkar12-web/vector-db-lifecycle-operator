# The operator image. Built from the repository root because the operator shares the planner with the lab.
FROM golang:1.24 AS build
WORKDIR /src
COPY go.mod ./
COPY internal ./internal
COPY operator ./operator
WORKDIR /src/operator
RUN go mod download && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /manager ./cmd/manager

FROM gcr.io/distroless/static:nonroot
COPY --from=build /manager /manager
USER 65532:65532
ENTRYPOINT ["/manager"]
